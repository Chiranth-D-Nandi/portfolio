# Resume Email Service Configuration
# Use Gmail with App Passwords for authentication

# The email address to send resumes FROM (your Gmail)
RESUME_EMAIL=your-email@gmail.com

# Admin email to receive resume requests
ADMIN_EMAIL=chiranth.nandi@gmail.com

# Google Drive link to resume (shareable link)
RESUME_DRIVE_LINK=https://drive.google.com/file/d/your-file-id/view

# Gmail App Password (generated from Google Account security settings)
# See: https://support.google.com/accounts/answer/185833
RESUME_EMAIL_PASSWORD=your-app-password

# Base URL for resume request accept/reject links (used in admin email)
# For local development:
BASE_URL=http://localhost:5000
# For production, use your deployed server URL:
# BASE_URL=https://your-domain.com

# Optional: MongoDB for likes feature
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# Server Port
PORT=5000
