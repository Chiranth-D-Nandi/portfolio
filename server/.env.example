# Resume Email Service Configuration (Resend - Recommended)
# Get a free API key at https://resend.com
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=onboarding@resend.dev

# Admin email to receive resume requests (must be your Resend account email if using onboarding@resend.dev)
ADMIN_EMAIL=120hertzyt@gmail.com

# Google Drive link to resume (shareable link)
RESUME_DRIVE_LINK=https://drive.google.com/file/d/18lzjQhipGMAuJezl8JeUp5VMTwlR6d_f/view?usp=drive_link

# Base URL for resume request accept/reject links
# For local dev:
# BASE_URL=http://localhost:5000
# For production Render:
BASE_URL=https://portfolio-teub.onrender.com

# Optional: Legacy Nodemailer (only if not using Resend)
# RESUME_EMAIL=your-email@gmail.com
# RESUME_EMAIL_PASSWORD=your-app-password

# Optional: MongoDB for likes feature
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# Server Port
PORT=5000
